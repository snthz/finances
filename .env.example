# Única variable obligatoria: Postgres
# (en Dokploy: "Internal Connection URL" de tu servicio de base de datos)
DATABASE_URL=postgres://usuario:password@host:5432/finances

# Todo lo demás (cuenta, moneda, zona horaria, monedas, Gmail y clave de IA) lo configura cada usuario en la app.

# --- Inicio de sesión con Google (opcional) ---
# Google Cloud Console → Credenciales → ID de cliente OAuth (aplicación web).
# URI de redirección autorizada: <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# URL pública de la app (recomendado en producción). Si no se define, se usa el host de la petición.
# APP_URL=https://finances.example.com

# --- Opcionales ---
# Secreto de sesión fijo. Si no se define, se genera uno y se guarda en la base de datos.
# SESSION_SECRET=
# Para disparar la sincronización de todos los usuarios desde fuera: POST /api/sync con "Authorization: Bearer <CRON_SECRET>"
# CRON_SECRET=
# Pon "false" sólo si accedes por http sin TLS (no recomendado)
# COOKIE_SECURE=true
# Antiguo: clave de Anthropic de toda la instancia. Si existe, se asigna una sola vez al primer usuario;
# ahora cada usuario pone su propia clave (Claude u OpenAI) en Ajustes → IA.
# ANTHROPIC_API_KEY=
